/* ---------- QUIZ ---------- */
var quizIndex = 0;
var quizAnswers = loadAnswers();
var quizStartedTracked = false;
function renderQuiz(){
  var sid = getSessionId();
  var startKey = "wbm-funnel-quiz-started-"+sid;
  try{
    if(!sessionStorage.getItem(startKey)){ sessionStorage.setItem(startKey,"1"); track("quiz_started"); }
  }catch(e){ if(!quizStartedTracked){ quizStartedTracked = true; track("quiz_started"); } }
  var q = QUIZ_QUESTIONS[quizIndex];
  var progress = ((quizIndex+1)/QUIZ_QUESTIONS.length)*100;
  var current = null;
  for(var i=0;i<quizAnswers.length;i++){ if(quizAnswers[i].questionId===q.id) current = quizAnswers[i].value; }
  var opts = q.options.map(function(opt){
    return '<button type="button" class="answer-button'+(current===opt?' answer-button--selected':'')+'" data-answer="'+esc(opt)+'"><span>'+esc(opt)+'</span><span aria-hidden="true">\u2192</span></button>';
  }).join("");
  var back = quizIndex>0 ? '<button class="back-button" type="button" data-action="quiz-back">\u2190 Go back</button>' : '';
  return '<main class="quiz-page"><header class="quiz-header shell">'+wordmark(true)+'<span>Qualification check</span></header>'
  + '<section class="quiz-shell shell"><div class="quiz-progress-meta"><span>QUESTION '+String(quizIndex+1).padStart(2,"0")+' / '+String(QUIZ_QUESTIONS.length).padStart(2,"0")+'</span><span>'+Math.round(progress)+'% COMPLETE</span></div>'
  + '<div class="quiz-progress" aria-hidden="true"><span style="width:'+progress+'%"></span></div>'
  + '<div class="quiz-card"><p class="eyebrow">Quick fit check</p><h1>'+esc(q.prompt)+'</h1><p class="quiz-card__support">Choose the answer that is true for you. A clear answer helps everyone make the right decision.</p><div class="answer-list" role="list">'+opts+'</div>'+back+'</div>'
  + '<aside class="quiz-honesty"><img src="data:image/jpeg;base64," alt="WBM Integrity Financial team" /><p><strong>This is a two-way filter.</strong> We care about whether the opportunity fits your goals just as much as whether you fit the opportunity.</p></aside></section>'
  + footerHtml()+'</main>';
}
function chooseAnswer(value){
  var q = QUIZ_QUESTIONS[quizIndex];
  quizAnswers = quizAnswers.filter(function(a){ return a.questionId!==q.id; });
  quizAnswers.push({ questionId: q.id, value: value });
  saveAnswers(quizAnswers);
  track("quiz_answered", { questionIndex: quizIndex, answer: value });
  if(q.disqualifyingAnswers.indexOf(value) !== -1){
    track("disqualified", { questionIndex: quizIndex, answer: value });
    navigate("/not-a-fit");
    return;
  }
  if(quizIndex === QUIZ_QUESTIONS.length-1){
    track("quiz_completed", { questionIndex: quizIndex, answer: value });
    track("qualified", { incomeGoal: value });
    navigate("/book-your-call");
    return;
  }
  quizIndex++;
  render();
  window.scrollTo(0,0);
}

