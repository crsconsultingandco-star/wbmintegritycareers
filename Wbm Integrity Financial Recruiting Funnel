  + footerHtml()+'</main>';
}
function bindBooking(){
  var frame = document.getElementById("calendlyFrame");
  if(frame){
    frame.addEventListener("load", function(){
      if(!bookingStartRecorded){ bookingStartRecorded = true; track("booking_started"); }
    });
  }
  var btn = document.getElementById("bookInterviewBtn");
  if(btn){
    btn.addEventListener("click", function(){
      if(!bookingStartRecorded){ bookingStartRecorded = true; }
      track("booking_started");
    });
