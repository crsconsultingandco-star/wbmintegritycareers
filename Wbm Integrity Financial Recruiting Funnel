/* ---------- METRICS (local-only) ---------- */
function pct(n){ return n.toFixed(1)+"%"; }
function renderMetrics(){
  var evts = loadEvents();
  function count(t){ return evts.filter(function(e){ return e.type===t; }).length; }
  var starts = count("quiz_started");
  var completions = count("quiz_completed");
  var qualified = count("qualified");
  var bookings = count("booking_completed");
  var completionRate = starts ? (completions/starts)*100 : 0;
  var qualificationRate = completions ? (qualified/completions)*100 : 0;
  var bookingRate = qualified ? (bookings/qualified)*100 : 0;
  var perQ = [];
  var hasAnswers = false;
  for(var qi=0; qi<QUIZ_QUESTIONS.length; qi++){
    var c = evts.filter(function(e){ return e.type==="quiz_answered" && e.questionIndex===qi; }).length;
    perQ.push(c);
    if(c>0) hasAnswers = true;
  }
  var dropoff = hasAnswers ? '<div class="dropoff-list">'+perQ.map(function(c, idx){
    var w = starts ? Math.min(100, (c/starts)*100) : 0;
    return '<div><span>Question '+(idx+1)+'</span><span class="dropoff-track"><i style="width:'+w+'%"></i></span><strong>'+c+'</strong></div>';
  }).join("")+'</div>' : '<p class="empty-metrics">No quiz answers have been recorded yet.</p>';
  return '<main class="metrics-page"><header class="quiz-header shell">'+wordmark(true)+'<span>Private funnel reporting</span></header>'
  + '<section class="metrics-shell shell"><div class="metrics-heading"><p class="eyebrow">Owner dashboard</p><h1>Funnel health at a glance.</h1><p>Anonymous conversion events only. Counts are stored locally in this browser \u2014 no login, no database.</p></div>'
  + '<div class="metrics-grid"><article><span>Quiz starts</span><strong>'+starts+'</strong></article>'
  + '<article><span>Quiz completions</span><strong>'+completions+'</strong><small>'+pct(completionRate)+' completion</small></article>'
  + '<article><span>Qualified</span><strong>'+qualified+'</strong><small>'+pct(qualificationRate)+' of completions</small></article>'
  + '<article><span>Bookings</span><strong>'+bookings+'</strong><small>'+pct(bookingRate)+' of qualified</small></article></div>'
  + '<section class="dropoff-panel"><p class="eyebrow">Question-by-question progress</p><h2>See where people keep moving\u2014or stop.</h2>'+dropoff+'</section>'
  + '<p style="margin-top:26px"><button type="button" class="text-link" data-action="clear-metrics" style="margin-top:0">Clear local counts on this browser</button></p>'
  + '</section></main>';
}

/* ---------- NOT FOUND ---------- */
function renderNotFound(){
  return '<main class="quiz-page"><header class="quiz-header shell">'+wordmark(true)+'<span>Page not found</span></header><section class="result-shell shell"><div class="result-intro"><p class="eyebrow">404</p><h1>This page wandered off.</h1><p>The page you\'re looking for doesn\'t exist. Head back to the start of the funnel.</p><p style="margin-top:28px"><button type="button" class="primary-button" data-action="go-home"><span>Return home</span><span aria-hidden="true">\u2192</span></button></p></div></section>'+footerHtml()+'</main>';
}

/* ---------- ROUTER ---------- */
function render(){
  var route = currentRoute();
  var app = document.getElementById("app");
  var html;
  if(route==="/"){ html = renderHome(); }
  else if(route==="/qualify"){ html = renderQuiz(); }
  else if(route==="/book-your-call" || route==="/qualified"){ bookingStartRecorded = false; html = renderBooking(); }
  else if(route==="/not-a-fit"){ html = renderDisqualified(); }
  else if(route==="/metrics"){ html = renderMetrics(); }
  else { html = renderNotFound(); }
  app.innerHTML = html;
  if(route==="/book-your-call" || route==="/qualified"){ bindBooking(); }
}
document.addEventListener("click", function(e){
  var ansBtn = e.target.closest ? e.target.closest("[data-answer]") : null;
  if(ansBtn){ chooseAnswer(ansBtn.getAttribute("data-answer")); return; }
  var actBtn = e.target.closest ? e.target.closest("[data-action]") : null;
  if(!actBtn) return;
  var action = actBtn.getAttribute("data-action");
  if(action==="start-quiz"){ quizIndex = 0; quizAnswers = loadAnswers(); navigate("/qualify"); }
  else if(action==="quiz-back"){ if(quizIndex>0) quizIndex--; render(); window.scrollTo(0,0); }
  else if(action==="go-home"){ navigate("/"); }
  else if(action==="clear-metrics"){ try{ localStorage.removeItem(EVENTS_KEY); }catch(err){} render(); }
});
window.addEventListener("hashchange", function(){ render(); window.scrollTo(0,0); });
render();
</script>
