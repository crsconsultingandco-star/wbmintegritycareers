}
function primaryButton(label, action){
  return '<button class="primary-button" type="button" data-action="'+action+'"><span>'+esc(label)+'</span><span aria-hidden="true">\u2192</span></button>';
}
function navigate(path){
  var target = "#"+path;
  if(location.hash === target){ render(); } else { location.hash = target; }
  window.scrollTo(0,0);
}
function currentRoute(){
  var h = location.hash || "";
  var p = h.replace(/^#/,"");
  if(!p || p==="/") return "/";
  return p;
}

