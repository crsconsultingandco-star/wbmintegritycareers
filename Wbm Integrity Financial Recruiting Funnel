function esc(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function getSessionId(){
  try{
    var cur = sessionStorage.getItem(SESSION_KEY);
    if(cur) return cur;
    var next = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : "s-"+Date.now()+"-"+Math.random().toString(36).slice(2);
    sessionStorage.setItem(SESSION_KEY, next);
    return next;
  }catch(e){ return "s-"+Date.now(); }
}
function loadEvents(){
  try{ var v = localStorage.getItem(EVENTS_KEY); var a = v ? JSON.parse(v) : []; return Array.isArray(a) ? a : []; }catch(e){ return []; }
}
function track(eventType, details){
  try{
    var evts = loadEvents();
    var rec = { type: eventType, sessionId: getSessionId(), ts: Date.now() };
    if(details){ if(typeof details.questionIndex==="number") rec.questionIndex = details.questionIndex; if(details.answer) rec.answer = details.answer; if(details.incomeGoal) rec.incomeGoal = details.incomeGoal; }
    evts.push(rec);
    localStorage.setItem(EVENTS_KEY, JSON.stringify(evts));
  }catch(e){}
}
function loadAnswers(){
  try{ var v = sessionStorage.getItem(ANSWERS_KEY); return v ? JSON.parse(v) : []; }catch(e){ return []; }
}
function saveAnswers(a){ try{ sessionStorage.setItem(ANSWERS_KEY, JSON.stringify(a)); }catch(e){} }

function wordmark(inverted){
  return '<div class="funnel-wordmark'+(inverted?' funnel-wordmark--inverted':'')+'" aria-label="WBM Integrity Financial"><span class="funnel-wordmark__monogram">WBM</span><span class="funnel-wordmark__name">Integrity Financial</span></div>';
}
function footerHtml(){
