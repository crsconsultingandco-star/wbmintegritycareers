var bookingStartRecorded = false;
var bookingDoneRecorded = false;
function calendlyEmbedUrl(){
  var sep = CALENDLY_URL.indexOf("?")!==-1 ? "&" : "?";
  return CALENDLY_URL+sep+"hide_gdpr_banner=1&background_color=050506&text_color=ffffff&primary_color=8b5cf6";
